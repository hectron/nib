{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/hectron/nib/main/docs/config.schema.json",
  "title": "nib configuration",
  "description": "Configuration for the nib command-line interface.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "list": {
          "type": "string",
          "description": "Default Reminders list."
        },
        "priority": {
          "type": "string",
          "enum": ["low", "medium", "high"],
          "description": "Default reminder priority."
        },
        "parse_inline": {
          "type": "boolean",
          "default": true,
          "description": "Parse trailing due dates, priorities, and list names."
        }
      }
    },
    "cal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calendars": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Calendars included by default."
        },
        "show_calendar": {
          "type": "boolean",
          "default": false,
          "description": "Show each event's calendar in event tables."
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "folder": {
          "type": "string",
          "description": "Default folder for newly created notes."
        }
      }
    },
    "tui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": {
          "type": "string",
          "enum": ["default"],
          "default": "default",
          "description": "Base keymap preset."
        },
        "keys": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "browse": { "$ref": "#/$defs/keyBindings" },
            "filter": { "$ref": "#/$defs/keyBindings" },
            "capture": { "$ref": "#/$defs/keyBindings" }
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "string",
      "enum": [
        "up",
        "down",
        "page-up",
        "page-down",
        "top",
        "bottom",
        "filter",
        "capture",
        "clear-filter",
        "keep-filter",
        "select-toggle",
        "select-all",
        "act-menu",
        "done",
        "reopen",
        "priority-high",
        "priority-medium",
        "priority-low",
        "priority-none",
        "move",
        "edit",
        "delete",
        "add",
        "quit",
        "help",
        "accept",
        "cancel",
        "next-pane",
        "prev-pane",
        "preview-toggle",
        "none"
      ]
    },
    "binding": {
      "oneOf": [
        { "$ref": "#/$defs/action" },
        {
          "type": "array",
          "items": { "$ref": "#/$defs/action" },
          "minItems": 1
        }
      ]
    },
    "keyBindings": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": { "$ref": "#/$defs/binding" }
    }
  }
}
